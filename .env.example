# --- Model: any OpenAI-compatible chat completions endpoint with tool calling ---
# Groq (default, free tier): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-5-mini
# Anthropic: LLM_BASE_URL=https://api.anthropic.com/v1   LLM_MODEL=claude-sonnet-5-5

# --- Web search: Tavily, https://app.tavily.com (1,000 free searches a month) ---
TAVILY_API_KEY=

# --- Optional ---
PORT=3000
# Pretend "now" is another time (ISO 8601), for trying date questions against seeded history.
# NOW_OVERRIDE=2026-11-10T15:00:00+05:30

# Optional: used only when LLM_MODEL is rate-limited (free tiers cap the best model hardest).
# Set to "" to disable and surface the rate limit instead.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
