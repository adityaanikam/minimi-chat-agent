{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A chat agent with one tool (web search) and a memory of every past conversation, with dates.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chrono-node": "^2.10.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
